# ==============================================================================
# File: iam/terraform.tfvars.example
# Description: Example variable values for the Standalone IAM module.
# ==============================================================================

project_id       = "<YOUR_PROJECT_ID>"
terraform_runner = "user:admin@example.com" # or "serviceAccount:tf-runner@my-project.iam.gserviceaccount.com"

# Jumpbox SSH User identity
jumpbox_ssh_user = "user:ssh-operator@example.com" # or "serviceAccount:jumpbox-ssh-user@my-project.iam.gserviceaccount.com"

# Jumpbox Script Runner Identity (executes Python scripts on the jumpbox)
jumpbox_script_runner = "user:operator@example.com"
