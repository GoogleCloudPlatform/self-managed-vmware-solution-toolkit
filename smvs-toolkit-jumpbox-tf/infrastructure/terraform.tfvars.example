# ==============================================================================
# File: infrastructure/terraform.tfvars.example
# Description: Example variable values file for main infrastructure deployment.
# ==============================================================================

# Required Parameters
project_id = "<YOUR_PROJECT_ID>"
region     = "<YOUR_REGION>"


# Network Parameters
# Scenario A: Create a NEW Subnet (default)
create_subnet = true
vpc_name      = "vcf-mgmt-sample-vpc" # Must be the same VPC hosting the ESXi nodes
subnet_name   = "vcf-mgmt-sample-jumpbox-subnet"
subnet_cidr   = "10.1.100.0/29" # Min /29 CIDR required when creating new subnet

# Scenario B: Use an EXISTING Subnet
# If NAT & internet egress already exist on the network, set `enable_internet = false`.
# create_subnet = false
# vpc_name      = "vcf-mgmt-sample-vpc" # Optional when create_subnet = false (must be the VPC hosting the ESXi nodes)
# subnet_name   = "vcf-mgmt-sample-existing-subnet"
# subnet_cidr   = "" # Not required when using existing subnet

# Cloud Router, Cloud NAT & Default Internet Route Egress Control
# Set enable_internet = true (default) to create NAT, Router, and default internet route for package downloads.
# Set enable_internet = false for 1: post-setup to tear down NAT, Router, and default route to lock down egress and 2: Internet access already exists for given VPC/subnet.
enable_internet = true

# Jumpbox Settings
jumpbox_name          = "vcf-mgmt-sample-jumpbox"  # Optional: defaults to "smvs-toolkit-jumpbox"
machine_type          = "e2-micro"              # Optional: defaults to "e2-micro"
boot_disk_size        = 30                      # Optional: size in GB (defaults to 30, min 10 GB)
boot_disk_type        = "pd-balanced"           # Optional: defaults to "pd-balanced" (options: "pd-standard", "pd-balanced", "pd-ssd", "pd-extreme")
boot_disk_image       = "debian-cloud/debian-12" # Optional: OS boot image (defaults to "debian-cloud/debian-12")
jumpbox_internal_ip   = ""                      # Optional: static IPv4 (e.g. "10.10.0.5") or reserved IP name (e.g. "my-reserved-ip"). Defaults to "" for dynamic/ephemeral IP.
service_account_email = ""                      # Optional: custom SA email (e.g. "my-custom-sa@my-project.iam.gserviceaccount.com"). Defaults to "" for default Compute Engine SA.

# RECOMMENDATION: Set `zone` to the exact GCP zone where your ESXi instances reside
zone = "us-east4-c" # Optional: defaults to "<region>-a"
