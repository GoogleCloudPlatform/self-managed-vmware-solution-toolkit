# ==============================================================================
# File: infrastructure/modules/jumpbox/terraform.tfvars.example
# Description: Example variable values for the Jumpbox submodule.
# ==============================================================================

# Target GCP Project ID & Zone
project_id = "my-gcp-project-id"
zone       = "us-central1-a"

# Jumpbox VM Instance Parameters
jumpbox_name          = "smvs-toolkit-jumpbox"
subnet_name           = "smvs-toolkit-jumpbox-subnet" # Subnet in the VPC hosting the ESXi nodes
service_account_email = "123456789012-compute@developer.gserviceaccount.com"

# Hardware & Disk Sizing (Optional - defaults shown)
machine_type    = "e2-micro"
boot_disk_size  = 30
boot_disk_type  = "pd-balanced"
boot_disk_image = "debian-cloud/debian-12"

# Internal IP (Optional - defaults to "" for ephemeral/dynamic IP)
internal_ip = "" # e.g. "10.10.0.5" or leave empty for dynamic IP
