# ==============================================================================
# File: infrastructure/modules/network/terraform.tfvars.example
# Description: Example variable values for the Network module.
# ==============================================================================

# Target GCP Project ID & Region
project_id = "my-gcp-project-id"
region     = "us-central1"

# Service Account Email (Target for IAP firewall rule)
service_account_email = "123456789012-compute@developer.gserviceaccount.com"

# Network Parameters
# Scenario A: Create a NEW Subnet (default)
create_subnet = true
vpc_name      = "my-custom-vpc" # Must be the same VPC hosting the ESXi nodes
subnet_name   = "smvs-toolkit-jumpbox-subnet"
subnet_cidr   = "10.10.0.0/28" # Minimum /29 required for GCP subnets

# Scenario B: Use an EXISTING Subnet
# create_subnet = false
# vpc_name      = "my-existing-vpc" # Optional: auto-detected if left empty (must be the VPC hosting the ESXi nodes)
# subnet_name   = "existing-esxi-connected-subnet"
# subnet_cidr   = "" # Not required when create_subnet = false

# Outbound Internet Egress Control (Cloud Router, Cloud NAT & Default Route)
# Set enable_internet = true (default) to provision NAT and default internet route for package downloads.
# Set enable_internet = false post-setup or if existing network already has NAT.
enable_internet = true
